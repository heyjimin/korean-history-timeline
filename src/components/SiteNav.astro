---
import ThemeToggle from './ThemeToggle.astro';
// 표·소개 페이지 위쪽 메뉴. 타임라인 화면 머리의 버튼과 같은 모양으로 맞춘다.
interface Props {
  current: 'timeline' | 'table' | 'people' | 'about';
}
const { current } = Astro.props;
const base = import.meta.env.BASE_URL.replace(/\/$/, '');
const items = [
  { id: 'timeline', label: '타임라인', href: `${base}/` },
  { id: 'table', label: '표', href: `${base}/table/` },
  { id: 'people', label: '인물', href: `${base}/people/` },
  { id: 'about', label: '소개', href: `${base}/about/` },
] as const;
---

<nav class="site-nav" aria-label="사이트 메뉴">
  {
    items.map((item) => (
      <a href={item.href} class="site-nav-link" aria-current={item.id === current ? 'page' : undefined}>
        <svg viewBox="0 0 16 16" width="14" height="14" aria-hidden="true" fill="none" stroke="currentColor" stroke-width="1.6" stroke-linecap="round">
          {item.id === 'timeline' && (
            <>
              <path d="M1.5 8h13" />
              <circle cx="4" cy="8" r="1.6" fill="currentColor" />
              <circle cx="9" cy="8" r="1.6" fill="currentColor" />
              <path d="M9 4.5v2M4 9.5v2M13 4.5v2" />
            </>
          )}
          {item.id === 'table' && (
            <>
              <rect x="2" y="2.5" width="12" height="11" rx="1.5" />
              <path d="M2 6h12M2 9.5h12M6 6v7.5" />
            </>
          )}
          {item.id === 'people' && (
            <>
              <circle cx="8" cy="5.5" r="2.6" />
              <path d="M3 14c.6-2.8 2.6-4.3 5-4.3s4.4 1.5 5 4.3" />
            </>
          )}
          {item.id === 'about' && (
            <>
              <circle cx="8" cy="8" r="6" />
              <path d="M8 7.2v4M8 4.9v.1" />
            </>
          )}
        </svg>
        <span>{item.label}</span>
      </a>
    ))
  }
  <ThemeToggle />
</nav>
