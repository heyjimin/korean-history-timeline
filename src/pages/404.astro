---
// 없는 주소로 들어왔을 때 (GitHub Pages가 404.html을 보여 준다)
import HeadCommon from '../components/HeadCommon.astro';
import Logo from '../components/Logo.tsx';
import SiteNav from '../components/SiteNav.astro';
import { SITE } from '../site.ts';
import '../styles/table.css';

const base = import.meta.env.BASE_URL.replace(/\/$/, '');
---

<!doctype html>
<html lang="ko">
  <head>
    <HeadCommon title={`페이지를 찾을 수 없습니다 | ${SITE.name}`} description={SITE.description} />
    <meta name="robots" content="noindex" />
  </head>
  <body>
    <header class="t-header">
      <a class="t-brand" href={`${base}/`}><Logo size={24} /> {SITE.name}</a>
      <SiteNav current="timeline" />
    </header>
    <main class="t-main about">
      <p class="about-kicker">404</p>
      <h1>페이지를 찾을 수 없습니다</h1>
      <p class="t-lead">주소가 바뀌었거나 없는 사건일 수 있습니다. 타임라인에서 검색해 보세요.</p>
      <p><a class="site-nav-link" href={`${base}/`}>타임라인으로 가기</a></p>
    </main>
  </body>
</html>
