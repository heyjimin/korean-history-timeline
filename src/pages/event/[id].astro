---
// 사건마다 정적 페이지를 만든다 → GitHub Pages에서도 /event/<id>/ 주소로 바로 열리고 공유 미리보기가 된다.
import AppLayout from '../../layouts/App.astro';
import { loadDataset } from '../../data/load.ts';

export function getStaticPaths() {
  const { dataset } = loadDataset();
  return dataset.events.map((event) => ({ params: { id: event.id } }));
}

const { id } = Astro.params;
---

<AppLayout initialId={id} />
